{
  "name": "lexandro-portfolio",
  "version": "1.0.0",
  "description": "Сайт-портфолио Алексея Свешникова: Next.js со статической выгрузкой на GitHub Pages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node tools/check-content.mjs && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check:content": "node tools/check-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/unbounded": "^5.3.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.4.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
